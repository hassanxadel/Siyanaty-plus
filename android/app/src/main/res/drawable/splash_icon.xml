<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ system splash icon (shown briefly, masked to a CIRCLE by the OS).

  Uses the box-free logo (@drawable/splash_logo) on the #062117 icon
  background, so no square shows. The mark is wider than tall, so it is inset
  to keep the whole logo inside the circular mask. Increase the inset if the
  edges clip; decrease it for a larger logo.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:inset="22%" />
